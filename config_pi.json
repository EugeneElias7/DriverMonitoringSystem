{
  "face": {
    "detector_model_path": "models/face_detection_yunet_2023mar.onnx",
    "landmark_model_path": "models/2d106det.onnx",
    "min_detection_confidence": 0.2
  },
  "detectors": [
    {
      "name": "cigarette",
      "model_path": "models/cigarette_smokers_v4.onnx",
      "classes_path": "models/cigarette_v4_classes.txt",
      "classes_whitelist": [
        "cigarette"
      ],
      "conf_threshold": 0.25,
      "target_hz": 1.0,
      "enabled": true
    },
    {
      "name": "phone",
      "model_path": "models/phone_yolo11n.onnx",
      "classes_path": "models/coco_classes.txt",
      "classes_whitelist": [
        "cell phone"
      ],
      "class_conf_overrides": {
        "cell phone": 0.25
      },
      "conf_threshold": 0.25,
      "target_hz": 1.0,
      "enabled": true
    }
  ],
  "thresholds": {
    "ear_closed": 0.20,
    "drowsy_max_yaw_deg": 85.0,
    "drowsy_max_pitch_deg": 55.0,
    "microsleep_s": 0.3,
    "perclos_alert": 0.35,
    "perclos_window_s": 4.0,
    "yawn_mar": 0.35,
    "yawn_s": 0.8,
    "microsleep_min_frames": 1,
    "perclos_min_samples": 10,
    "cigarette_s": 1.0,
    "cigarette_high_conf": 0.60,
    "cigarette_low_conf": 0.50,
    "cigarette_low_s": 1.5,
    "cigarette_hold_s": 4.0,
    "cigarette_bridge_s": 1.0,
    "cigarette_gate_span": 0.2,
    "cigarette_max_size_span": 0.8,
    "cigarette_min_aspect": 1.2,
    "cigarette_mouth_pad_span": 0.28,
    "phone_low_conf": 0.25,
    "phone_hand_conf": 0.3,
    "phone_call_s": 0.8,
    "phone_in_hand_s": 0.8,
    "phone_hold_s": 3.0,
    "phone_max_size_span": 1.0,
    "seatbelt_check": false,
    "yaw_away_deg": 999.0,
    "pitch_away_deg": 999.0,
    "eating_s": 999.0
  },
  "audio": {
    "enabled": true,
    "announce_startup": true,
    "device": "plughw:Headphones"
  },
  "camera": {
    "controls": {
      "AwbEnable": false,
      "ColourGains": [
        0.95,
        1.0
      ]
    }
  },
  "alert_cooldown_s": 5.0,
  "capture_width": 640,
  "capture_height": 480,
  "target_fps": 5,
  "opencv_threads": 1,
  "serialize_detectors": false,
  "face_first": true,
  "self_test": false,
  "display": true
}